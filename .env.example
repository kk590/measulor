# PayPal Payment Integration Configuration
# Copy this file to .env and fill in your actual values

# PayPal Configuration (get these from https://developer.paypal.com/)
# For sandbox/testing mode:
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox  # Use 'production' for live payments

# Product Configuration
PRODUCT_PRICE=29.99
PRODUCT_CURRENCY=USD
PRODUCT_NAME=Measulor Premium License

# Security Configuration
ENCRYPTION_KEY=your_encryption_key_here  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_secret_key_here  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Optional: Flask configuration
FLASK_ENV=production
FLASK_DEBUG=False
