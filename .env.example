# Copy to .env (or set in your host's dashboard) and fill in real values.

APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=
DATA_DIR=/app/data
CORS_ORIGINS=

# ---- Paddle Billing (live or sandbox) ----
# REQUIRED whenever any Paddle credential is set. Never omit — we refuse to guess.
# sandbox | production
PADDLE_ENVIRONMENT=

# Server-side API key (transaction.read, customer.read, customer_portal_session.write)
PADDLE_API_KEY=

# Client-side token for Paddle.js (live_... for production, test_... for sandbox)
PADDLE_CLIENT_TOKEN=

# Default / legacy single price (used as Pro monthly fallback)
PADDLE_PRICE_ID=

# 3-tier catalogue — create six prices in Paddle Catalog and paste pri_ IDs here
PADDLE_PRICE_ID_STARTER_MONTH=
PADDLE_PRICE_ID_STARTER_YEAR=
PADDLE_PRICE_ID_PRO_MONTH=
PADDLE_PRICE_ID_PRO_YEAR=
PADDLE_PRICE_ID_ADVANCED_MONTH=
PADDLE_PRICE_ID_ADVANCED_YEAR=

# Optional hosted checkout link (fallback if overlay is unavailable)
# Must be a page on your approved domain for live (e.g. https://measulor.vercel.app/pricing)
PADDLE_CHECKOUT_URL=

# Webhook notification destination secret
PADDLE_WEBHOOK_SECRET=

PRICE_LABEL=₹199/month
SCANS_PER_PURCHASE=1
# PAYMENTS_REQUIRED=false

MAX_UPLOAD_MB=200
WORKER_THREADS=2
KEEP_ARTIFACTS_HOURS=72
LOG_LEVEL=INFO
