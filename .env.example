# Copy to .env (or set in your host's dashboard) and fill in real values.

APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Defaults to SQLite in DATA_DIR. Use Postgres in production, e.g. postgresql+psycopg2://user:pass@host/db
DATABASE_URL=
DATA_DIR=/app/data
# Comma separated origins allowed to call the API cross-origin (leave empty when served from the same domain)
CORS_ORIGINS=

# Paddle Billing (https://vendors.paddle.com > Developer tools > Authentication)
# sandbox | production
PADDLE_ENVIRONMENT=sandbox
# server-side API key (needs transaction.read, customer.read, customer_portal_session.write)
PADDLE_API_KEY=
# pri_... of the ₹199/month recurring price
PADDLE_PRICE_ID=
# notification destination secret key
PADDLE_WEBHOOK_SECRET=
# Checkout: set a Paddle checkout link (e.g. https://pay.paddle.io/checkout/hsc_...) and/or a client-side token.
# With a checkout link the Subscribe button opens it; otherwise Paddle.js opens an overlay checkout.
PADDLE_CHECKOUT_URL=
# client-side token for Paddle.js overlay checkout
PADDLE_CLIENT_TOKEN=
# shown on the Subscribe button
PRICE_LABEL=₹199/month
# scans granted per purchase if PADDLE_PRICE_ID is a one-time price
SCANS_PER_PURCHASE=1
# payments turn on automatically once Paddle is configured; set true/false to override
# PAYMENTS_REQUIRED=false

# Pipeline limits
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=120
MAX_FRAMES=40
FRAME_MAX_DIMENSION=1600
WORKER_THREADS=2
KEEP_ARTIFACTS_HOURS=72
LOG_LEVEL=INFO
